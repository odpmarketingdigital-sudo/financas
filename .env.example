NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Landing Page — Colaboração voluntária
# Chave PIX exibida/codificada no modal "Colabore com o Projeto" (o QR Code é
# gerado dinamicamente a partir dela, sem imagem externa).
NEXT_PUBLIC_PIX_KEY=sua-chave-pix-aqui
# Opcional: URL de incorporação do vídeo tutorial (YouTube/Vimeo), ex.:
# https://www.youtube.com/embed/SEU_VIDEO_ID
NEXT_PUBLIC_TUTORIAL_VIDEO_URL=

# URL canônica do app (sem barra no final). Usada nos metadados de SEO e nos
# links de compartilhamento (Open Graph/Twitter) e na URL canônica.
# Em produção use https://tostaoemdia.com.br. Exemplo local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://tostaoemdia.com.br
